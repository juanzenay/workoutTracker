# Every environment variable workout tracker reads. docs/setup.md walks through each one.
# On Vercel: Project → Settings → Environment Variables, then redeploy. Locally: copy to .env.local.

# --- Supabase (Vercel's Supabase integration sets all of these) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# The integration sets NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY; NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable or anon key>
# Postgres used by the command layer (transaction pooler). The integration sets POSTGRES_URL; DATABASE_URL wins if both are set.
DATABASE_URL=postgres://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session connection the deploy step applies migrations over (set by the integration).
# POSTGRES_URL_NON_POOLING=postgres://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Server-side key for the backup's Supabase Storage fallback. The integration sets SUPABASE_SECRET_KEY and SUPABASE_URL.
# SUPABASE_SECRET_KEY=<secret key>          (or SUPABASE_SERVICE_ROLE_KEY=<service role key>)
# SUPABASE_URL=https://<project>.supabase.co

# --- Deployment (the Deploy button asks for these two) ---
# The only email that can claim this deployment (the first sign-up becomes the owner; nobody else can sign up after).
# Unset: whoever signs up first claims it.
OWNER_EMAIL=you@example.com
# Vercel Cron sends CRON_SECRET as a bearer token to /api/cron/*: nightly backup (/api/cron/backup) and the
# daily job (/api/cron/daily: re-plan for the new day, mark missed runs; with Strava, retry its events and posts).
# Any long random string.
CRON_SECRET=<long random string>
# Optional: public URL of this deployment (claim confirmation emails, MCP connector metadata). Default: the request host.
# SITE_URL=https://workout-tracker-you.vercel.app
# Deploy-time migrations (npm run db:deploy, run by "vercel-build"). Preview builds skip unless MIGRATE_PREVIEW=1.
# SKIP_MIGRATIONS=1
# MIGRATE_PREVIEW=1
# MIGRATIONS_DATABASE_URL=<overrides POSTGRES_URL_NON_POOLING for migrations>

# --- Strava (optional): your own API app (https://www.strava.com/settings/api). Callback domain = this deployment's host. ---
# Leave unset to import runs from files instead (Strava's API needs a paid subscription); nothing mentions Strava then.
# STRAVA_CLIENT_ID=12345
# STRAVA_CLIENT_SECRET=<client secret>
# Any random string; Strava echoes it in the webhook subscription handshake.
# STRAVA_WEBHOOK_VERIFY_TOKEN=<random string>
# Optional: Strava API root (default https://www.strava.com/api/v3; Strava's new host https://api-v3.strava.com works from 2027-01-04).
# STRAVA_API_BASE=https://www.strava.com/api/v3
# Optional: Strava OAuth root (default https://www.strava.com).
# STRAVA_OAUTH_BASE=https://www.strava.com

# --- Push notifications (Web Push). Generate a pair with: npx web-push generate-vapid-keys ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=<public key>
# VAPID_PRIVATE_KEY=<private key>
# Contact for push services: mailto:you@example.com or https://your-site
# VAPID_SUBJECT=mailto:you@example.com

# --- Nightly backup ---
# Primary target: a private GitHub repo you own, and a fine-grained token with Contents: read & write on it only.
# BACKUP_GITHUB_REPO=<you>/workout-tracker-backup
# BACKUP_GITHUB_TOKEN=github_pat_...
# BACKUP_GITHUB_BRANCH=main   # optional; defaults to the repo's default branch
# Fallback when no repo is set: Supabase Storage (private "backups" bucket, created on first run), using the secret key above.

# --- Optional services ---
# wger instance for fallback exercise search (default https://wger.de).
# WGER_BASE_URL=https://wger.de
# Hevy API root for the import (default https://api.hevyapp.com). The API key is entered in the app.
# HEVY_BASE_URL=https://api.hevyapp.com

# --- Tests only: local Postgres superuser used to build per-test databases. ---
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
